{
  "name": "qq-setup",
  "version": "0.1.0",
  "description": "Set up quirq infra (qq) for a GitHub org with one command and a short form.",
  "license": "Apache-2.0",
  "repository": "github:quirq-ai/setup",
  "type": "module",
  "bin": {
    "qq-setup": "cli/bin.mjs"
  },
  "files": [
    "cli/",
    "out/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "dev": "next dev",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "e2e": "playwright test",
    "check-form": "npm run build && git diff --exit-code -- out/ && test -z \"$(git status --porcelain -- out/)\""
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "lucide-react": "^0.545.0",
    "next": "16.3.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
