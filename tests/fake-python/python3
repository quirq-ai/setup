#!/usr/bin/env node
// A stand-in for Python in step 3's tests (QQ_PYTHON): it answers the few commands
// cli/policy-write.mjs runs, the way the real tools change files, without Python or the network.
//   --version                          prints Python 3.14.0 (qq-setup's preflight)
//   -c "...version_info..."            prints True
//   -m venv DIR                        makes DIR/bin/python (this script)
//   -m pip install ...                 installs nothing
//   -c "...qqgate..." settings plan --config IC   prints a plan naming settings' repos and IC's commit file
//   .../tools/qqcfg.py add-repo NAME --kind K ... --root R    appends a [[repo]] and a builder
//   .../tools/qqcfg.py remove-repo NAME --root R              takes them out
//   .../tools/qqcfg.py deliver NAME DEST --root R             writes DEST's qq workflow
// A file fake-python-fail at the root naming a qqcfg command (such as remove-repo) makes it refuse,
// as qqcfg does; the tools' environment carries no test variables, so a file says it.
const fs = process.getBuiltinModule("node:fs");
const path = process.getBuiltinModule("node:path");
const a = process.argv.slice(2);
const arg = (k) => a[a.indexOf(k) + 1];
const fail = (m) => (console.error(m), process.exit(1));
if (a[0] === "--version") { console.log("Python 3.14.0"); process.exit(0); }
if (process.env.HOME && !process.env.HOME.includes("qq-setup-policies-")) fail("fake python: HOME is not the scratch home");
if (process.env.GH_TOKEN || process.env.GITHUB_TOKEN) fail("fake python: a token reached the child");
if (a[0] === "-c" && a[1].includes("version_info")) { console.log("True"); process.exit(0); }
if (a[0] === "-m" && a[1] === "venv") {
  fs.mkdirSync(path.join(a[2], "bin"), { recursive: true });
  fs.copyFileSync(process.argv[1], path.join(a[2], "bin", "python"));
  fs.chmodSync(path.join(a[2], "bin", "python"), 0o755);
  process.exit(0);
}
if (a[0] === "-m" && a[1] === "pip") process.exit(0);
if (a[0] === "-c" && a[1].includes("qqgate")) {
  const settings = fs.readFileSync("settings/github.toml", "utf8");
  const repos = [...settings.matchAll(/^name = "([^"]+)"/gm)].map((m) => m[1]);
  const listed = [...fs.readFileSync(path.join(arg("--config"), "config/repos.toml"), "utf8").matchAll(/^name = "([^"]+)"/gm)].map((m) => m[1]);
  const products = [...settings.matchAll(/^name = "([^"]+)"\n(?:[^\[]*\n)*?kind = "product"/gm)].map((m) => m[1]);
  const missing = products.filter((p) => !listed.includes(p));
  if (missing.length) fail(`qqgate: settings product repos differ from infra-config's: missing ${JSON.stringify(missing)}`);
  console.log(JSON.stringify({ repos, approvals: [...settings.matchAll(/^required_approvals = (\d+)/gm)].map((m) => Number(m[1])) }, null, 2));
  process.exit(0);
}
if (a[0]?.endsWith("tools/qqcfg.py")) {
  const [cmd, name] = [a[1], a[2]];
  const root = arg("--root");
  const repos = path.join(root, "config/repos.toml");
  const pipes = path.join(root, "config/pipelines.toml");
  const failing = path.join(root, "fake-python-fail");
  if (fs.existsSync(failing) && fs.readFileSync(failing, "utf8").trim() === cmd) fail(`qqcfg ${cmd}: ${name} is named in another area`);
  if (cmd === "add-repo") {
    fs.appendFileSync(repos, `\n[[repo]]\nname = "${name}"\nkinds = ${JSON.stringify(a.filter((_, i) => a[i - 1] === "--kind"))}\nchannels = []\n`);
    fs.appendFileSync(pipes, `\n[[builder]]\nname = "${name}-presubmit"\nrepo = "${name}"\npipeline = "presubmit"\ntriggers = ["change", "queue"]\nblocking = true\ngenerate = true\n`);
    console.log("PASS: validate");
    process.exit(0);
  }
  if (cmd === "remove-repo") {
    const cut = (f) => fs.writeFileSync(f, fs.readFileSync(f, "utf8").split(/\n(?=\[\[)/).filter((b) => !b.includes(`"${name}"`)).join("\n"));
    cut(repos);
    cut(pipes);
    console.log("PASS: validate");
    process.exit(0);
  }
  if (cmd === "deliver") {
    if (!fs.readFileSync(repos, "utf8").includes(`name = "${name}"`)) fail(`qqcfg deliver: no repo '${name}' in repos.toml`);
    const wf = path.join(a[3], ".github/workflows");
    fs.mkdirSync(wf, { recursive: true });
    fs.writeFileSync(path.join(wf, `qq-${name}-presubmit.yml`), `# GENERATED by the fake qqcfg\nname: "qq ${name}-presubmit"\n`);
    console.log(`wrote .github/workflows/qq-${name}-presubmit.yml`);
    process.exit(0);
  }
}
fail(`fake python: unexpected ${a.join(" ")}`);
