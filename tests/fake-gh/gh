#!/usr/bin/env node
// A stand-in for the GitHub CLI used by the e2e test: canned answers for the GET calls qq-setup makes.
// It never touches the network. Any call it does not know fails the way gh does on a 404.
const args = process.argv.slice(2);
if (args[0] === "--version") { console.log("gh version 2.89.0 (fake)"); process.exit(0); }
if (args[0] !== "api" || args[1] !== "--hostname" || args[2] !== "github.com" || args[3] !== "--method" || args[4] !== "GET") {
  console.error(`fake gh: only "api --hostname github.com --method GET" calls are allowed, got: ${args.join(" ")}`);
  process.exit(9);
}
const path = args[args.length - 1];
// FAKE_GH_LOG names a file that gets one line per path asked for, so a test can show what was read.
if (process.env.FAKE_GH_LOG) process.getBuiltinModule("node:fs").appendFileSync(process.env.FAKE_GH_LOG, `${path}\n`);
const b64 = (o) => Buffer.from(JSON.stringify(o)).toString("base64");
const repo = (name, extra = {}) => ({ name, visibility: "public", archived: false, fork: false, default_branch: "main", ...extra });
const files = (...names) => names.map((name) => ({ name, type: "file" }));
const routes = {
  "user": { login: "sam-example" },
  "user/memberships/orgs?state=active&per_page=100&page=1": [
    { role: "admin", organization: { login: "acme-labs" } },
    { role: "member", organization: { login: "big-co" } },
  ],
  "orgs/acme-labs/repos?type=all&sort=pushed&direction=desc&per_page=100&page=1": [
    repo("billing-api"), repo("web"), repo("marketing-site"), repo("ios-app"),
    repo("old-thing", { archived: true }), repo("secret-sauce", { visibility: "private" }), repo("empty"),
  ],
  "repos/acme-labs/billing-api/contents/?ref=main": [...files("requirements.txt", "requirements-dev.txt", "app.py"), { name: "tests", type: "dir" }],
  "repos/acme-labs/billing-api/contents/requirements-dev.txt?ref=main": { encoding: "base64", content: Buffer.from("-r requirements.txt\npytest==8.4.2\n").toString("base64") },
  "repos/acme-labs/web/contents/?ref=main": [...files("package.json", "pnpm-lock.yaml"), { name: "infra", type: "dir" }],
  "repos/acme-labs/web/contents/package.json?ref=main": { encoding: "base64", content: b64({ dependencies: { next: "16.3.8" }, scripts: { build: "next build", typecheck: "tsc --noEmit" } }) },
  "repos/acme-labs/web/contents/infra/repo.toml?ref=main": { name: "repo.toml" },
  "repos/acme-labs/marketing-site/contents/?ref=main": files("package.json", "package-lock.json"),
  "repos/acme-labs/marketing-site/contents/package.json?ref=main": { encoding: "base64", content: b64({ dependencies: { next: "16.3.8" } }) },
  "repos/acme-labs/ios-app/contents/?ref=main": files("Package.swift"),
  // What already guards the repos the e2e test picks: web has old protection; billing-api's protection
  // answers a plain 404 (as GitHub does for a non-admin), which must read as "could not read".
  "repos/acme-labs/billing-api": repo("billing-api", { allow_squash_merge: true }),
  "repos/acme-labs/billing-api/rulesets?includes_parents=true": [],
  "repos/acme-labs/web": repo("web", { allow_squash_merge: true }),
  "repos/acme-labs/web/rulesets?includes_parents=true": [{ id: 7, name: "release-freeze" }],
  "repos/acme-labs/web/branches/main/protection": {
    required_status_checks: { contexts: ["ci/build"], checks: [{ context: "ci/build" }] },
    required_pull_request_reviews: { required_approving_review_count: 1 },
  },
  // quirq-ai's own tool repos are named, not inspected (the unit test checks the call log).
  "orgs/quirq-ai/repos?type=all&sort=pushed&direction=desc&per_page=100&page=1": [repo("gate"), repo("Release"), repo("Gate-notes"), repo("ios-app")],
  "repos/quirq-ai/ios-app/contents/?ref=main": files("Package.swift"),
  // An old repo past the 100 the form lists: only a direct GET finds it.
  "repos/acme-labs/old-archive-2019": { name: "old-archive-2019" },
};
// FAKE_GH_QUIRQ: the login is also a member of quirq-ai, so the form offers step 3 (its repo policies).
const text = (t) => ({ encoding: "base64", content: Buffer.from(t).toString("base64") });
if (process.env.FAKE_GH_QUIRQ) {
  routes["user/memberships/orgs?state=active&per_page=100&page=1"].push({ role: "member", organization: { login: "quirq-ai" } });
  Object.assign(routes, {
    "repos/quirq-ai/gate/contents/settings/github.toml?ref=main": text(`[main]
ruleset = "qq-main"
required_approvals = 0

[[repo]]
name = "web"
kind = "product"
allow_auto_merge = true
required_approvals = 1
transitional_checks = []

[[repo]]
name = "gate"
kind = "infra"
allow_auto_merge = true
checks = ["presubmit"]
code_owner_review = true
`),
    "repos/quirq-ai/infra-config/contents/config/repos.toml?ref=main": text(`[[repo]]
name = "web"
kinds = ["node-app"]
channels = ["canary", "stable"]
[repo.deploy]
target = "vercel"

[[repo]]
name = "cli"
kinds = ["python-package"]
channels = []
`),
    "repos/quirq-ai/infra-config/contents/config/pipelines.toml?ref=main": text(`[[builder]]
name = "web-presubmit"
repo = "web"
pipeline = "presubmit"
triggers = ["change", "queue"]
blocking = true
generate = true

[[builder]]
name = "cli-presubmit"
repo = "cli"
pipeline = "presubmit"
triggers = ["change", "queue"]
blocking = true
generate = true
`),
    "repos/quirq-ai/infra-config/contents/config/org.toml?ref=main": text(`[[infra_repo]]
name = "gate"
`),
    // The repos themselves, for their default branch; cli is registered but not there (404).
    "repos/quirq-ai/web": repo("web"),
    "repos/quirq-ai/gate": repo("gate"),
    "repos/quirq-ai/web/rulesets?includes_parents=true&per_page=100": [{ id: 1, name: "qq-main", enforcement: "active" }],
    "repos/quirq-ai/web/contents/.github/CODEOWNERS?ref=main": text("* @sam-example\n"),
    "repos/quirq-ai/gate/rulesets?includes_parents=true&per_page=100": [],
    "repos/quirq-ai/cli/rulesets?includes_parents=true&per_page=100": [],
  });
}
// FAKE_GH_NO_ORGS: a login that owns no org (it is only a member of big-co).
if (process.env.FAKE_GH_NO_ORGS) routes["user/memberships/orgs?state=active&per_page=100&page=1"].splice(0, 1);
// FAKE_GH_NO_LOGIN: gh is installed but not logged in.
if (process.env.FAKE_GH_NO_LOGIN) {
  console.error("To get started with GitHub CLI, please run:  gh auth login");
  process.exit(4);
}
if (args.includes("--include") && path === "user") {
  process.stdout.write("HTTP/2.0 200 OK\r\nX-Oauth-Scopes: gist, read:org, repo, workflow\r\n\r\n" + JSON.stringify(routes.user));
  process.exit(0);
}
// FAKE_GH_SLOW names one path that answers after 3 seconds, as a slow GitHub would.
if (process.env.FAKE_GH_SLOW === path) Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 3000);
if (path in routes) { process.stdout.write(JSON.stringify(routes[path])); process.exit(0); }
console.error(`gh: Not Found (HTTP 404)`);
process.exit(1);
